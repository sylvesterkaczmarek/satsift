    "splits": [
      "development",
      "calibration",
      "confirmatory"
    ],
    "unit": "NORAD object",
    "rule": "Every NORAD object belongs to exactly one split. Confirmatory objects are frozen before any v1.0 detector tuning or confirmatory scoring.",
    "development_note": "May be inspected and used for model development.",
    "calibration_note": "May be used for calibration and operational threshold/risk setting.",
    "confirmatory_note": "Must remain untouched by detector tuning and performance inspection until the final confirmatory run."
  },
  "label_policy": {
    "event_evidence": "Only documented truth intervals score true positives/false negatives. Predictions outside those intervals remain unscored.",
    "verified_quiet": "Only intervals with explicit authoritative evidence that orbital maneuvering had ceased, was unavailable, or required no further assistance contribute false-positive exposure.",
    "unlabelled": "Unlabelled time is never treated as negative ground truth.",
    "matching_tolerance_hours": 24
  },
