# BEGIN satsift compatibility routes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # THE_REQUEST stays raw through internal rewrites. Accept only literal public
  # paths; encoded aliases and direct requests for the physical directory fail.
  RewriteCond %{THE_REQUEST} !\s/+(?:satsift|satellite-maneuver-detector)(?:\.html|/+|/(?:docs|benchmark|accessibility)(?:\.html|/*)|/benchmark/(?:manifest|template)/*|/history/?|/dependency-notices\.txt|/(?:app-3\.4|plotly-3\.3\.1\.min|satellite-6\.0\.2\.min)\.js|/app/(?:common|orbital-input|benchmark|packages|detection|interface|bootstrap)-[0-9a-f]{12}\.js)?(?:\?[^\s]*)?\s
  RewriteRule ^(?:satsift|(?:tools/)?satellite-maneuver-detector)(?:/|$|\.html$) - [F,L,NC]
  RewriteCond expr "unescape(%{THE_REQUEST}) =~ m#^\S+\s/+tools/satellite-maneuver-detector(?:/|[?\s])#i"
  RewriteRule ^ - [F,L]

  # Retain both public module namespaces for previously cached HTML. Reject
  # symlinks and unknown filenames before any host-wide fallback can run.
  RewriteCond %{DOCUMENT_ROOT}/tools/satellite-maneuver-detector/app -l [OR]
  RewriteCond %{DOCUMENT_ROOT}/tools/satellite-maneuver-detector/app/$1 -l
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/app/((?:common|orbital-input|benchmark|packages|detection|interface|bootstrap)-[0-9a-f]{12}\.js)$ - [F,L]
  RewriteCond %{THE_REQUEST} \s/+(?:satsift|satellite-maneuver-detector)/app/(?:common|orbital-input|benchmark|packages|detection|interface|bootstrap)-[0-9a-f]{12}\.js(?:[?\s]|$)
  RewriteCond %{DOCUMENT_ROOT}/tools/satellite-maneuver-detector/app/$1 -f
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/app/((?:common|orbital-input|benchmark|packages|detection|interface|bootstrap)-[0-9a-f]{12}\.js)$ tools/satellite-maneuver-detector/app/$1 [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/app(?:/|$) - [R=404,L]

  # Machine endpoints keep their HTTP method, body and query string. They are
  # shared rewrites, so old browser sessions never need an API redirect.
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/history/?$ tools/satellite-maneuver-detector/history.php [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/benchmark/manifest/?$ tools/satellite-maneuver-detector/public-evidence-manifest-v0.1.json [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/benchmark/template/?$ tools/satellite-maneuver-detector/benchmark-template.json [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/app-3\.4\.js$ tools/satellite-maneuver-detector/app-3.4.js [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/plotly-3\.3\.1\.min\.js$ tools/satellite-maneuver-detector/plotly-3.3.1.min.js [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/satellite-6\.0\.2\.min\.js$ tools/satellite-maneuver-detector/satellite-6.0.2.min.js [END]
  RewriteRule ^(?:satsift|satellite-maneuver-detector)/dependency-notices\.txt$ tools/satellite-maneuver-detector/dependency-notices.txt [END]

  # Apache may normalise repeated slashes before RewriteRule sees the path.
  RewriteCond %{THE_REQUEST} \s/+satsift//+(?:\?[^\s]*)?\s
  RewriteRule ^satsift/+$ https://www.sylvesterkaczmarek.com/satsift/ [R=301,L,NE]

  # These new public routes also remain reachable after a release rollback.
  # Their physical files are backed up and restored as part of the transaction.
  RewriteRule ^satsift/docs$ tools/satellite-maneuver-detector/docs.html [END]
  RewriteRule ^satsift/benchmark$ tools/satellite-maneuver-detector/benchmark.html [END]
  RewriteRule ^satsift/accessibility$ tools/satellite-maneuver-detector/accessibility.html [END]
  RewriteRule ^satsift/$ tools/satellite-maneuver-detector/index.html [END]
</IfModule>
<IfModule mod_headers.c>
  # Original request scoping survives internal rewrites and upstream TLS
  # termination. Browsers process HSTS only on secure transport.
  Header always set X-Content-Type-Options "nosniff" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
  Header always set Referrer-Policy "strict-origin-when-cross-origin" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
  Header always set X-Frame-Options "DENY" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://celestrak.org; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
  Header always set X-Robots-Tag "noindex, nofollow, nosnippet" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)/(?:history(?:[/?\s]|$)|benchmark/(?:manifest|template)(?:[/?\s]|$)|dependency-notices\.txt(?:[?\s]|$)|(?:app-3\.4|plotly-3\.3\.1\.min|satellite-6\.0\.2\.min)\.js(?:[?\s]|$)|app/(?:common|orbital-input|benchmark|packages|detection|interface|bootstrap)-[0-9a-f]{12}\.js(?:[?\s]|$))#"
  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=(%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 206 || %{REQUEST_STATUS} == 304) && %{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)/app/(?:common|orbital-input|benchmark|packages|detection|interface|bootstrap)-[0-9a-f]{12}\.js(?:[?\s]|$)#"
  Header always set Cache-Control "no-cache" "expr=%{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:/*|\.html|/(?:docs|benchmark|accessibility)(?:\.html|/*)|/app-3\.4\.js|/dependency-notices\.txt)(?:[?\s]|$)#"
  # A request for a not-yet-deployed hash must not cache a long-lived 404.
  Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} >= 400 && %{THE_REQUEST} =~ m#\s/+(?:satsift|satellite-maneuver-detector)(?:[./?\s]|$)#"
</IfModule>
# END satsift compatibility routes

# BEGIN satsift managed configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.space-track-config\.php$ - [F,L,NC]
  RewriteRule (^|/)\.satellite-maneuver-cache(?:/|$) - [F,L,NC]

  # Old indexable pages redirect to one canonical SatSift URL. Apache preserves
  # query strings because these substitutions do not supply a replacement query.
  RewriteRule ^satellite-maneuver-detector(?:\.html|/*)$ https://www.sylvesterkaczmarek.com/satsift/ [R=301,L,NE]
  RewriteRule ^satellite-maneuver-detector/(docs|benchmark|accessibility)(?:\.html|/*)$ https://www.sylvesterkaczmarek.com/satsift/$1 [R=301,L,NE]
  RewriteRule ^satsift(?:\.html)?$ https://www.sylvesterkaczmarek.com/satsift/ [R=301,L,NE]
  RewriteRule ^satsift/(docs|benchmark|accessibility)(?:\.html|/+)$ https://www.sylvesterkaczmarek.com/satsift/$1 [R=301,L,NE]
</IfModule>
# END satsift managed configuration
